{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "PhenoAI",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://**", "https://**"]
      },
      "shell": {
        "sidecar": true,
        "scope": [
          {
            "name": "fish_backend",
            "sidecar": true,
            "args": true
          }
        ]
      },
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "readDir": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "exists": true,
        "scope": ["$APPCONFIG", "$APPCONFIG/**", "$APPDATA", "$APPDATA/**", "$DOWNLOADS", "$DOWNLOADS/**", "$HOME", "$HOME/**"]
      },
      "protocol": {
        "asset": true,
        "assetScope": ["$HOME/**", "$APPDATA/**", "$APPCONFIG/**"]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.cavfish.morphometrics",
      "icon": [
        "icons/icon.ico",
        "icons/icon.icns"
      ],
      "targets": "all",
      "externalBin": [],
      "resources": [
        "../setup_onnx_runtime.py",
        "../runtime/python",
        "../../inference_runtime/**",
        "../../inference_runtime/*",
        "../../backend/**",
        "../../backend/*",
        "../../models/cavfish_v1/**",
        "../../models/cavfish_v1/*"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost;"
    },
    "windows": [
      {
        "title": "PhenoAI",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "focus": true
      }
    ],
    "updater": {
      "active": false
    }
  }
}
